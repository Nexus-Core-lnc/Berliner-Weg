# Copiez ce fichier en ".env" et remplissez vos vraies valeurs. Ne jamais committer le fichier ".env" !

SECRET_KEY=change-moi-en-une-chaine-aleatoire

# Adresse Gmail utilisée pour ENVOYER les emails (ex: contact.berlinerweg@gmail.com)
MAIL_USERNAME=votre-adresse@gmail.com

# Mot de passe d'application Gmail (PAS votre mot de passe habituel)
# Voir le README pour savoir comment le générer.
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Adresse qui doit RECEVOIR les demandes de rendez-vous (peut être la même que MAIL_USERNAME)
CENTRE_EMAIL=votre-adresse@gmail.com
